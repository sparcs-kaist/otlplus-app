# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

module AppStoreContentFrequency
  NONE = "NONE".freeze
end

APP_STORE_AGE_RATING_ATTRIBUTES = {
  "advertising" => false,
  "ageAssurance" => false,
  "gunsOrOtherWeapons" => AppStoreContentFrequency::NONE,
  "healthOrWellnessTopics" => false,
  "lootBox" => false,
  "messagingAndChat" => true,
  "parentalControls" => false,
  "socialMedia" => true,
  "socialMediaAgeRestricted" => false,
  "userGeneratedContent" => true,
}.freeze

APP_STORE_DEFAULT_METADATA_LOCALE = "en-US".freeze
APP_STORE_METADATA_LOCALE_DIRECTORIES = {
  "en-US" => "en-US",
  "ko" => "ko",
  "ko-KR" => "ko",
}.freeze
APP_STORE_METADATA_DIRECTORY = File.expand_path("metadata", __dir__).freeze

def app_store_release_notes(locale:)
  metadata_locale = APP_STORE_METADATA_LOCALE_DIRECTORIES.fetch(
    locale,
    APP_STORE_DEFAULT_METADATA_LOCALE,
  )
  release_notes_path = File.join(
    APP_STORE_METADATA_DIRECTORY,
    metadata_locale,
    "release_notes.txt",
  )
  UI.user_error!("Missing App Store release notes for locale #{locale}") unless File.exist?(release_notes_path)

  release_notes = File.read(release_notes_path).strip
  UI.user_error!("App Store release notes are empty for locale #{locale}") if release_notes.empty?

  release_notes
end

def update_app_store_review_metadata
  app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
  app = Spaceship::ConnectAPI::App.find(app_identifier)
  UI.user_error!("Could not find App Store Connect app #{app_identifier}") unless app

  app_info = app.fetch_edit_app_info || app.fetch_latest_app_info
  UI.user_error!("Could not find editable App Store app information") unless app_info

  age_rating_declaration = app_info.fetch_age_rating_declaration
  UI.user_error!("Could not find App Store age rating declaration") unless age_rating_declaration
  age_rating_declaration.update(attributes: APP_STORE_AGE_RATING_ATTRIBUTES)

  version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
  UI.user_error!("Could not find editable iOS App Store version") unless version

  localizations = version.get_app_store_version_localizations
  UI.user_error!("Could not find iOS App Store version localizations") if localizations.empty?

  localizations.each do |localization|
    localization.update(
      attributes: {
        whats_new: app_store_release_notes(locale: localization.locale),
      },
    )
  end
end

def apply_release_profile(target:, profile_path:, team_id:, sdk:)
  unless File.exist?(profile_path)
    UI.user_error!("Missing provisioning profile for #{target}: #{profile_path}")
  end

  update_code_signing_settings(
    use_automatic_signing: false,
    path: "Runner.xcodeproj",
    team_id: team_id,
    targets: [target],
    build_configurations: ["Release"],
    code_sign_identity: "Apple Distribution",
    sdk: sdk,
  )

  update_project_provisioning(
    xcodeproj: "Runner.xcodeproj",
    profile: profile_path,
    target_filter: "^#{Regexp.escape(target)}$",
    build_configuration: "Release",
    code_signing_identity: "Apple Distribution",
  )
end

def build_release_ipa
  increment_build_number(
    build_number: Time.now.strftime("%y%m%d.%H%M"),
    xcodeproj: "Runner.xcodeproj",
  )
  sh "flutter pub get"
  sh "bundle exec pod install"
  posthog_host = ENV.fetch("POSTHOG_HOST", "https://us.i.posthog.com")
  sh "flutter build ios --config-only --release --no-codesign --dart-define=POSTHOG_API_KEY=#{ENV.fetch('POSTHOG_API_KEY')} --dart-define=POSTHOG_HOST=#{posthog_host} --dart-define=POSTHOG_PROJECT_ID=#{ENV.fetch('POSTHOG_PROJECT_ID', '')} --dart-define=POSTHOG_REGION=#{ENV.fetch('POSTHOG_REGION', '')}"

  team_id = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
  update_project_team(teamid: team_id)

  main_profile = ENV["IOS_PROFILE_NAME"]
  widget_profile = ENV["IOS_WIDGET_PROFILE_NAME"]
  intents_profile = ENV["IOS_INTENTS_PROFILE_NAME"]
  watch_profile = ENV["IOS_WATCH_PROFILE_NAME"]
  main_profile_uuid = ENV["IOS_PROFILE_UUID"]
  widget_profile_uuid = ENV["IOS_WIDGET_PROFILE_UUID"]
  intents_profile_uuid = ENV["IOS_INTENTS_PROFILE_UUID"]
  watch_profile_uuid = ENV["IOS_WATCH_PROFILE_UUID"]
  profile_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
  main_profile_path = File.join(profile_dir, "profile.mobileprovision")
  widget_profile_path = File.join(profile_dir, "profile_widget.mobileprovision")
  intents_profile_path = File.join(profile_dir, "profile_intents.mobileprovision")
  watch_profile_path = File.join(profile_dir, "profile_watch.mobileprovision")

  use_manual_signing = !main_profile.to_s.empty? &&
                       !widget_profile.to_s.empty? &&
                       !intents_profile.to_s.empty? &&
                       !watch_profile.to_s.empty? &&
                       !main_profile_uuid.to_s.empty? &&
                       !widget_profile_uuid.to_s.empty? &&
                       !intents_profile_uuid.to_s.empty? &&
                       !watch_profile_uuid.to_s.empty?

  if use_manual_signing
    UI.message("📝 Using manual code signing with explicit provisioning profiles")
    apply_release_profile(target: "Runner", profile_path: main_profile_path, team_id: team_id, sdk: "iphoneos*")
    apply_release_profile(target: "OTLWidgetsExtension", profile_path: widget_profile_path, team_id: team_id, sdk: "iphoneos*")
    apply_release_profile(target: "OTLPlusIntents", profile_path: intents_profile_path, team_id: team_id, sdk: "iphoneos*")
    apply_release_profile(target: "OTL Watch App", profile_path: watch_profile_path, team_id: team_id, sdk: "watchos*")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      clean: true,
      export_method: "app-store",
      destination: "generic/platform=iOS",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          "org.sparcs.otlplus" => main_profile_uuid,
          "org.sparcs.otlplus.widget" => widget_profile_uuid,
          "org.sparcs.otlplus.intents" => intents_profile_uuid,
          "org.sparcs.otlplus.watchkitapp" => watch_profile_uuid,
        },
      },
    )
  else
    UI.message("⚠️ IOS_*_PROFILE_NAME env vars not set, falling back to legacy build_app config")
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      clean: true,
      export_method: "app-store",
      destination: "generic/platform=iOS",
    )
  end
end

def app_store_connect_api_key_from_env
  asc_key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
  asc_issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  asc_key_content = ENV["APP_STORE_CONNECT_API_KEY"]

  return if asc_key_id.to_s.empty? || asc_issuer_id.to_s.empty? || asc_key_content.to_s.empty?

  UI.message("🔑 Using App Store Connect API key for upload")
  app_store_connect_api_key(
    key_id: asc_key_id,
    issuer_id: asc_issuer_id,
    key_content: asc_key_content,
    is_key_content_base64: !asc_key_content.include?("BEGIN PRIVATE KEY"),
    in_house: false,
  )
end

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :alpha do
    build_release_ipa
    api_key = app_store_connect_api_key_from_env

    if api_key
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true,
      )
    else
      UI.message("🔑 Using Apple ID + app-specific password for upload (legacy)")
      upload_to_testflight(
        skip_waiting_for_build_processing: true,
      )
    end
  end

  desc "Submit a signed build to App Store review"
  lane :submit_review do
    api_key = app_store_connect_api_key_from_env
    UI.user_error!("App Store Connect API key is required for review submission") unless api_key
    update_app_store_review_metadata
    build_release_ipa

    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
    )
  end

  desc "Report the current App Store review state"
  lane :review_status do
    UI.user_error!("App Store Connect API key is required") unless app_store_connect_api_key_from_env

    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    version = app.get_latest_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    state = version&.app_version_state || "unknown"
    version_string = version&.version_string || "unknown"
    puts "store=ios"
    puts "state=#{state}"
    puts "version=#{version_string}"
  end
end
